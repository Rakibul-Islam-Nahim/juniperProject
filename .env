# --- Backend ---
APP_NAME=lab-platform-backend
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lab:lab@localhost:5432/labplatform
DATABASE_URL_SYNC=postgresql://lab:lab@localhost:5432/labplatform   # for alembic

# --- IPAM ---
# The standalone IPAM microservice runs on port 8100. When running the
# backend outside of docker (developer workflow), use http://localhost:8100.
# Inside docker-compose, the service name "ipam-service" resolves via DNS.
IPAM_POOL=172.30.0.0/16
IPAM_PREFIX_LEN=24
IPAM_SERVICE_URL=http://localhost:8100

# --- Resources / quotas ---
MAX_LABS_PER_HOST=10
CPU_QUOTA=64
MEM_QUOTA_MB=131072

# --- Hypervisor ---
HYPERVISOR_BACKEND=local_ch
CH_BRIDGE=br0
CH_TAP_PREFIX=tap
CH_DISK_DIR=./var/runtime-disks
CH_API_SOCKET_DIR=./var/ch-sockets

# --- Lab Agent (in-microVM) ---
LAB_AGENT_BASE_URL=http://172.30.0.10:9001
DEVICE_READINESS_TIMEOUT_SEC=1800
DEVICE_READINESS_POLL_SEC=5

# --- Backend ports ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CH_BINARY=/usr/local/bin/cloud-hypervisor
CH_KERNEL=/home/rakib/juniperLab/juniper_router_vm/kernel/linux/arch/x86/boot/bzImage
CH_IMAGE_DIR=/home/rakib/juniperLab/juniper_router_vm/customFS
CH_SEED_DIR=/home/rakib/juniperLab/juniper_router_vm/images
CH_SEED_FILE=seed.iso
